# Copy this file to .env and fill in what you have. Everything is optional:
# with no keys, the app runs on its rule-based document reader.

# Free key from https://aistudio.google.com  (Get API key)
GEMINI_API_KEY=
# Models to try, in order. A busy or retired model fails over to the next one.
GEMINI_MODEL=gemini-flash-lite-latest,gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Optional fallback, free key from https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# auto = use AI when a key is set, fall back to rules.  off = never call a model.
AI_MODE=auto

# Seconds each stage stays on screen in the live run view.
STAGE_DELAY=0.5

BUYER_NAME=Acme Retail India

# Reuse the AI reading when the exact same file is uploaded again (saves free-tier quota).
AI_CACHE=on
